DATABASE_URL="mysql://username:password@host:port/database"

# https://generate-secret.vercel.app/ for generating a secure random string
# 32 characters required
SESSION_PASSWORD=""

# Get this from Valve: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=""

# The full URL of your app, used for the Steam callback
# For development:
NEXT_PUBLIC_URL="http://localhost:3000"
# For production:
# NEXT_PUBLIC_URL="https://your-domain.com"

# Server Configuration
# Display name for your CS2 server (shown in website title and header)
NEXT_PUBLIC_SERVER_NAME="CS2 Community Server"

# Website title (browser tab title)
NEXT_PUBLIC_SITE_TITLE="CS2 Community Server - Skins Control Panel"

# CS2 Game Server Connection Settings
# IP address of your CS2 server
NEXT_PUBLIC_SERVER_IP="127.0.0.1"

# Port number of your CS2 server (default: 27015)
NEXT_PUBLIC_SERVER_PORT="27015"

# Image Cache Configuration
# Enable or disable local image caching from CDN
# Set to "true" to cache images locally (useful for regions with CDN access issues)
# Set to "false" to load images directly from CDN (recommended for stable CDN access)
# Default: true
ENABLE_IMAGE_CACHE="true"